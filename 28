<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Change Text Color</title>
</head>
<body>
  <p id="myText">Hello, world!</p>

  <button onclick="changeColor()">
    Change text to red
  </button>

  <script>
    function changeColor() {
      document.getElementById("myText").style.color = "red";
    }
  </script>
</body>
</html>
